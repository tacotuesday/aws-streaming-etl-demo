# Copy this file to secrets.env and fill in your actual values
# secrets.env is listed in .gitignore and should never be committed

# AWS Credentials - get from https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# CloudFormation Redshift Serverless Parameters
REDSHIFT_NAMESPACE_NAME=rswg
REDSHIFT_DATABASE_NAME=dev
REDSHIFT_ADMIN_USERNAME=admin
REDSHIFT_ADMIN_PASSWORD=your-strong-admin-password-here-challenge-you-can-guess-it
REDSHIFT_WORKGROUP_NAME=redshiftworkgroup
REDSHIFT_BASE_RPU=8
REDSHIFT_PUBLICLY_ACCESSIBLE=false
REDSHIFT_SUBNET_IDS=subnet-xxx,subnet-yyy,subnet-zzz
REDSHIFT_SECURITY_GROUP_IDS=sg-xxx

# Lambda Deployment - should be replaced with parameter overrides in production
LAMBDA_CODE_BUCKET=tacotuesday-s3-bucket
